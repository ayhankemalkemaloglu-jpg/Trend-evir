# --- beehiiv (email subscriptions) ---
# Create an API key in beehiiv → Settings → Integrations → API.
BEEHIIV_API_KEY=
# Publication ID, looks like: pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BEEHIIV_PUBLICATION_ID=

# --- Plausible analytics (optional, privacy-friendly) ---
# The domain you registered in Plausible, e.g. trendcevir.com
# When unset, the analytics script is simply not loaded.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Contact form (Resend) ---
# Used by /api/contact. When any of these is unset, the contact form
# returns a friendly "not configured" message instead of sending.
RESEND_API_KEY=
# Where contact messages are delivered:
CONTACT_TO=iletisim@trendcevir.com
# Verified Resend sender, e.g. "TrendÇevir <site@trendcevir.com>"
CONTACT_FROM=

# --- Anthropic (AI idea generator /fikir-uretici + weekly draft automation) ---
# When unset, /api/generate-ideas returns a friendly "not configured" message
# and the weekly automation is skipped — the rest of the site works normally.
ANTHROPIC_API_KEY=
# Optional model override for the idea generator (default: a fast Haiku model).
ANTHROPIC_IDEAS_MODEL=
